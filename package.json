{
  "name": "cc-ws-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter './apps/web' dev",
    "start": "bun --filter './apps/web' start",
    "build": "bun --filter './packages/element' build",
    "test": "bun test",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run build && for dir in packages/*; do (cd \"$dir\" && bun publish --access public --tolerate-republish); done && changeset tag"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "latest",
    "bun-types": "^1.3.13",
    "typescript": "^5.6.0"
  }
}
