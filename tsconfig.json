{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["bun-types"]
  },
  "include": [
    "packages/client/src/**/*",
    "packages/react/src/**/*",
    "packages/server/src/**/*"
  ],
  "exclude": [
    "apps/**",
    "packages/svelte/**",
    "**/*.svelte",
    "**/node_modules"
  ]
}
