node_modules/
.env
.env.local
# release.yml writes a token-bearing .npmrc at job start; changesets'
# `git add .` inside `bun run version` would otherwise sweep it into the
# version-bump commit and GitHub secret scanning blocks the push.
.npmrc
.DS_Store
*.log
bun.lockb

# Build outputs
dist/
dist-embed/
.svelte-kit/
.vite/

# Local scratch / test artifacts
.perm-test*.txt
_dev.log

# Per-snapshot extractor outputs that are derived from canonical.json + the
# binary itself. Only canonical.json, patches.ts, binary-metadata.json,
# coverage.json, integration-fixtures/, integration-report.md, and failures.md
# get committed under codegen/snapshots/<ver>/; everything below is
# regenerated by extract.ts / generate.ts on demand.
codegen/snapshots/*/schemas.json
codegen/snapshots/*/unions.json
codegen/snapshots/*/report.md
codegen/snapshots/*/raw.js
