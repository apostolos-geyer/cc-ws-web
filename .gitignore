# Per-snapshot extractor outputs that are derived from canonical.json + the
# binary itself. Only canonical.json, patches.ts, and binary-metadata.json get
# committed under codegen/snapshots/<ver>/; everything below is regenerated by
# extract.ts / generate.ts / the integration harness on demand.
codegen/snapshots/*/schemas.json
codegen/snapshots/*/unions.json
codegen/snapshots/*/report.md
codegen/snapshots/*/raw.js
codegen/snapshots/*/coverage.json
codegen/snapshots/*/integration-fixtures/
codegen/snapshots/*/integration-report.md
codegen/snapshots/*/failures.md
