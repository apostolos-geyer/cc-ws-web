{
  "name": "@somewhatintelligent/cc-ws-server",
  "version": "0.1.3",
  "description": "Bun WebSocket server fronting Claude Code via NDJSON over stream-json. The container-side bridge for cc-ws.",
  "license": "MIT",
  "type": "module",
  "main": "./src/server.ts",
  "types": "./src/server.ts",
  "exports": {
    ".": "./src/server.ts"
  },
  "bin": {
    "cc-ws-server": "bin/cc-ws-server.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --hot src/server.ts"
  }
}
