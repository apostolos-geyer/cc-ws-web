{
  "name": "@somewhatintelligent/cc-ws-element",
  "version": "0.3.1",
  "description": "Drop-in <cc-ws-chat> custom element — embeddable Claude Code chat UI backed by a cc-ws WebSocket bridge.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cc-ws-chat.js",
  "types": "./dist/cc-ws-chat.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cc-ws-chat.d.ts",
      "default": "./dist/cc-ws-chat.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "vite build"
  },
  "sideEffects": true,
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@replit/codemirror-vim": "^6.3.0",
    "@somewhatintelligent/cc-ws-svelte": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.1.1",
    "@types/diff": "^8.0.0",
    "@types/dompurify": "^3.2.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.2",
    "marked": "^18.0.3",
    "nanostores": "^1.3.0",
    "shiki": "^4.0.2",
    "svelte": "^5.55.5",
    "vite": "^8.0.10"
  }
}
