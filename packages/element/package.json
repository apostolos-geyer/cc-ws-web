{
  "name": "@somewhatintelligent/cc-ws-element",
  "version": "0.1.3",
  "description": "Drop-in <cc-ws-chat> custom element — embeddable Claude Code chat UI backed by a cc-ws WebSocket bridge.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cc-ws-chat.js",
